{
  "version": 2,
  "rewrites": [
    { "source": "/m", "destination": "/m.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/v/:pnr", "destination": "/m.html?pnr=:pnr" },
    { "source": "/([a-zA-Z0-9_-]{5,8})", "destination": "/m.html?pnr=$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/m.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
